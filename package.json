{
  "name": "samjoe-foodapp",
  "version": "0.1.0",
  "private": true,
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "dev:api": "tsx --env-file=.env apps/api/src/server.ts",
    "dev:web": "npm run dev -w @foodapp/web",
    "dev:worker": "tsx --env-file=.env apps/worker/src/index.ts",
    "db:migrate": "tsx --env-file=.env scripts/migrate.ts",
    "import:catalog": "tsx --env-file=.env scripts/import-catalog.ts",
    "reconcile:catalog": "tsx --env-file=.env scripts/reconcile-catalog.ts"
  },
  "engines": { "node": ">=22" },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}

